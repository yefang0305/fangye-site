---
// ToolPageLayout.astro – Reusable dark-lab tool page wrapper.
// Wraps the page-hero header (title, description, trust badges) and
// the main tool-panel slot so every usable tool page shares one structure.

interface Badge {
  label: string;
  variant?: 'local' | 'api-key' | 'no-upload' | 'default';
}

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  badges?: Badge[];
  githubUrl?: string;
}

const { title, description, eyebrow = 'Tool', badges = [], githubUrl } = Astro.props;
---

<section class="page-hero">
  <p class="eyebrow">{eyebrow}</p>
  <div class="tool-title-row" style="display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: 18px;">
    <h1 style="margin-bottom: 0;">{title}</h1>
    {githubUrl && (
      <a class="button-link secondary" href={githubUrl} target="_blank" rel="noopener noreferrer" style="font-size: 13.5px; padding: 6px 14px; min-height: 34px; color: var(--text); background: rgba(255,255,255,0.05); font-weight: 700; border: 1px solid var(--line-strong); border-radius: var(--radius); display: inline-flex; align-items: center; gap: 6px;">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align:middle;">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
        </svg>
        <span>GitHub 源码</span>
      </a>
    )}
  </div>
  <p class="lead">{description}</p>
  {
    badges.length > 0 && (
      <div class="tool-badges" aria-label="工具属性" style="margin-top: 16px;">
        {badges.map((badge) => (
          <span class={`badge badge-${badge.variant || 'default'}`}>{badge.label}</span>
        ))}
      </div>
    )
  }
</section>

<section class="page-section">
  <div class="tool-panel">
    <slot />
  </div>
</section>

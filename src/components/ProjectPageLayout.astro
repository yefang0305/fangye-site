---
// ProjectPageLayout.astro – Reusable project showcase page wrapper.
// Provides consistent hero, content sections, and GitHub CTA for project pages.

export interface TechItem {
  label: string;
  items: string[];
}

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  techStack?: TechItem[];
  githubCta?: boolean;
}

const { title, description, eyebrow = 'Project', techStack = [], githubCta = true } = Astro.props;
---

<section class="page-hero">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p class="lead">{description}</p>
</section>

<section class="page-section">
  <div class="project-content">
    <slot />
  </div>

  {
    techStack.length > 0 && (
      <div class="project-tech-stack">
        <h3>技术栈</h3>
        <div class="tech-grid">
          {techStack.map((group) => (
            <div class="tech-group">
              <span class="tech-label">{group.label}</span>
              <div class="tech-tags">
                {group.items.map((item) => (
                  <span class="tag">{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    )
  }

  {
    githubCta && (
      <div class="project-cta">
        <div class="cta-panel">
          <div class="cta-left">
            <svg class="cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
            </svg>
            <div>
              <p class="cta-title">GitHub 仓库</p>
              <p class="cta-desc">仓库整理中，稍后会在这里放上链接。</p>
            </div>
          </div>
          <span class="cta-badge">仓库整理中</span>
        </div>
      </div>
    )
  }
</section>

<style>
  .project-content {
    max-width: 820px;
  }

  .project-content h2 {
    margin-top: 34px;
    font-size: 28px;
  }

  .project-content h3 {
    margin-top: 24px;
  }

  .project-content p,
  .project-content li {
    color: #c7d8d2;
    font-size: 17px;
    line-height: 1.82;
  }

  .project-content a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .project-content code {
    border-radius: 5px;
    padding: 2px 5px;
    background: rgba(159, 245, 215, 0.1);
  }

  .project-content ul,
  .project-content ol {
    padding-left: 20px;
  }

  .project-content li {
    margin-bottom: 8px;
  }

  /* SVG container */
  .project-svg {
    margin: 32px 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(20, 33, 40, 0.5);
    padding: 28px;
    overflow-x: auto;
  }

  .project-svg svg {
    width: 100%;
    height: auto;
  }

  /* Capability cards grid */
  .capability-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
    margin: 20px 0;
  }

  .capability-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(20, 33, 40, 0.5);
    padding: 20px;
    transition: border-color 0.2s ease;
  }

  .capability-card:hover {
    border-color: var(--line-strong);
  }

  .capability-card h4 {
    margin: 0 0 8px;
    font-size: 16px;
    color: var(--accent);
  }

  .capability-card p {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
    line-height: 1.6;
  }

  .capability-icon {
    width: 28px;
    height: 28px;
    color: var(--accent);
    margin-bottom: 10px;
  }

  /* Tech stack */
  .project-tech-stack {
    margin-top: 44px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }

  .project-tech-stack h3 {
    margin-bottom: 16px;
    font-size: 22px;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .tech-group {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(20, 33, 40, 0.4);
    padding: 16px;
  }

  .tech-label {
    display: block;
    margin-bottom: 10px;
    color: var(--subtle);
    font-size: 12px;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* CTA */
  .project-cta {
    margin-top: 44px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }

  .cta-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(135deg, rgba(20, 33, 40, 0.7) 0%, rgba(13, 22, 27, 0.8) 100%);
    padding: 22px 24px;
  }

  .cta-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .cta-icon {
    width: 36px;
    height: 36px;
    color: var(--muted);
    flex-shrink: 0;
  }

  .cta-title {
    margin: 0;
    color: var(--text);
    font-weight: 680;
    font-size: 16px;
  }

  .cta-desc {
    margin: 4px 0 0;
    color: var(--subtle);
    font-size: 14px;
  }

  .cta-badge {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 4px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.04);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Note / Warning boxes */
  .project-note {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 198, 109, 0.05);
    border-color: rgba(255, 198, 109, 0.18);
    padding: 16px 20px;
    margin: 24px 0;
  }

  .project-note p {
    margin: 0;
    font-size: 15px;
    color: var(--amber);
  }

  .project-note strong {
    color: var(--amber);
  }

  /* Workflow steps */
  .workflow-steps {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
    margin: 20px 0;
  }

  .workflow-step {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(20, 33, 40, 0.4);
    padding: 18px;
    text-align: center;
  }

  .workflow-step .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--accent-strong);
    color: var(--accent);
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .workflow-step h4 {
    margin: 0 0 4px;
    font-size: 15px;
    color: var(--text);
  }

  .workflow-step p {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.5;
  }

  @media (max-width: 860px) {
    .capability-grid,
    .tech-grid,
    .workflow-steps {
      grid-template-columns: 1fr;
    }

    .cta-panel {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

---
// ProjectPageLayout.astro – Reusable project showcase page wrapper.
// Provides consistent hero, content sections, and GitHub CTA for project pages.

export interface TechItem {
  label: string;
  items: string[];
}

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  techStack?: TechItem[];
  githubCta?: boolean;
}

const { title, description, eyebrow = 'Project', techStack = [], githubCta = true } = Astro.props;
---

<section class="page-hero">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p class="lead">{description}</p>
</section><section class="page-section">
  <div class="project-layout-grid">
    <!-- Main content column -->
    <div class="project-main">
      <slot />
    </div>

    <!-- Sidebar column -->
    <aside class="project-sidebar">
      {
        techStack.length > 0 && (
          <div class="project-tech-stack">
            <h3>技术栈</h3>
            <div class="tech-list">
              {techStack.map((group) => (
                <div class="tech-group">
                  <span class="tech-label">{group.label}</span>
                  <div class="tech-tags">
                    {group.items.map((item) => (
                      <span class="tag">{item}</span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )
      }

      {
        githubCta && (
          <div class="project-cta">
            <div class="cta-panel">
              <div class="cta-header">
                <svg class="cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                </svg>
                <span class="cta-title">GitHub 仓库</span>
              </div>
              <p class="cta-desc">仓库整理中，稍后会在这里放上链接。</p>
              <div class="cta-footer">
                <span class="cta-badge">仓库整理中</span>
              </div>
            </div>
          </div>
        )
      }
    </aside>
  </div>
</section>

<style>
  .project-layout-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(280px, 0.6fr);
    gap: 40px;
    align-items: start;
  }

  .project-main {
    max-width: 100%;
  }

  .project-main :global(h2) {
    margin-top: 34px;
    font-size: 28px;
  }

  .project-main :global(h3) {
    margin-top: 24px;
  }

  .project-main :global(p),
  .project-main :global(li) {
    color: #c7d8d2;
    font-size: 17px;
    line-height: 1.82;
  }

  .project-main :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .project-main :global(code) {
    border-radius: 5px;
    padding: 2px 5px;
    background: rgba(159, 245, 215, 0.1);
  }

  .project-main :global(ul),
  .project-main :global(ol) {
    padding-left: 20px;
  }

  .project-main :global(li) {
    margin-bottom: 8px;
  }

  /* SVG container */
  .project-main :global(.project-svg) {
    margin: 32px 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(20, 33, 40, 0.5);
    padding: 28px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow-x: auto;
  }

  .project-main :global(.project-svg svg) {
    width: 100%;
    max-width: 580px;
    height: auto;
    display: block;
  }

  /* Capability cards grid */
  .project-main :global(.capability-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
    margin: 20px 0;
  }

  .project-main :global(.capability-card) {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(20, 33, 40, 0.5);
    padding: 20px;
    transition: border-color 0.2s ease;
  }

  .project-main :global(.capability-card:hover) {
    border-color: var(--line-strong);
  }

  .project-main :global(.capability-card h4) {
    margin: 0 0 8px;
    font-size: 16px;
    color: var(--accent);
  }

  .project-main :global(.capability-card p) {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
    line-height: 1.6;
  }

  .project-main :global(.capability-icon) {
    width: 28px;
    height: 28px;
    color: var(--accent);
    margin-bottom: 10px;
  }

  /* Sidebar */
  .project-sidebar {
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: sticky;
    top: 24px;
  }

  .project-tech-stack {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(20, 33, 40, 0.4);
    padding: 24px;
  }

  .project-tech-stack h3 {
    margin-top: 0;
    margin-bottom: 16px;
    font-size: 18px;
    color: var(--accent);
  }

  .tech-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .tech-group {
    border: none;
    background: transparent;
    padding: 0;
  }

  .tech-label {
    display: block;
    margin-bottom: 8px;
    color: var(--subtle);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* CTA Panel inside Sidebar */
  .project-cta {
    border: none;
    padding-top: 0;
  }

  .cta-panel {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(135deg, rgba(20, 33, 40, 0.7) 0%, rgba(13, 22, 27, 0.8) 100%);
    padding: 24px;
  }

  .cta-header {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .cta-icon {
    width: 24px;
    height: 24px;
    color: var(--accent);
    flex-shrink: 0;
  }

  .cta-title {
    margin: 0;
    color: var(--text);
    font-weight: 700;
    font-size: 16px;
  }

  .cta-desc {
    margin: 0;
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.5;
  }

  .cta-footer {
    display: flex;
    justify-content: flex-end;
    margin-top: 4px;
  }

  .cta-badge {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 2px 10px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--subtle);
    background: rgba(255, 255, 255, 0.03);
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
  }

  /* Note / Warning boxes */
  .project-main :global(.project-note) {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 198, 109, 0.05);
    border-color: rgba(255, 198, 109, 0.18);
    padding: 16px 20px;
    margin: 24px 0;
  }

  .project-main :global(.project-note p) {
    margin: 0;
    font-size: 15px;
    color: var(--amber);
  }

  .project-main :global(.project-note strong) {
    color: var(--amber);
  }

  /* Workflow steps */
  .project-main :global(.workflow-steps) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
    margin: 20px 0;
  }

  .project-main :global(.workflow-step) {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(20, 33, 40, 0.4);
    padding: 18px;
    text-align: center;
  }

  .project-main :global(.workflow-step .step-num) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--accent-strong);
    color: var(--accent);
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .project-main :global(.workflow-step h4) {
    margin: 0 0 4px;
    font-size: 15px;
    color: var(--text);
  }

  .project-main :global(.workflow-step p) {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.5;
  }

  @media (max-width: 860px) {
    .project-layout-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .project-sidebar {
      position: static;
    }

    .project-main :global(.capability-grid),
    .project-main :global(.workflow-steps) {
      grid-template-columns: 1fr;
    }
  }
</style>

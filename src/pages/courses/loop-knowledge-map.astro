<style>
  :root{
    --bg:#0e1014;
    --panel:#161a21;
    --panel-2:#1c212b;
    --ink:#e8eaed;
    --ink-dim:#9aa3b0;
    --ink-faint:#6b7280;
    --line:#2a3140;
    --accent:#ff5b49;      /* 心脏/最致命 = 红 */
    --gold:#f6c453;        /* 关键金句 = 金 */
    --cyan:#5ad1c8;        /* 自主性/水管 = 青 */
    --violet:#9d8cff;      /* 用户洞见 = 紫 */
    --green:#5fd07a;
    --mono:"SF Mono",ui-monospace,"JetBrains Mono",Menlo,Consolas,monospace;
    --sans:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    background:radial-gradient(1200px 700px at 70% -10%,#1a2030 0%,var(--bg) 55%);
    color:var(--ink);font-family:var(--sans);line-height:1.7;
    -webkit-font-smoothing:antialiased;padding-bottom:80px;
  }
  .wrap{max-width:1080px;margin:0 auto;padding:0 24px}

  /* ---- header ---- */
  header{padding:72px 0 40px;text-align:center;border-bottom:1px solid var(--line)}
  .kicker{font-family:var(--mono);font-size:12px;letter-spacing:.32em;color:var(--cyan);text-transform:uppercase;margin-bottom:18px}
  h1{font-size:clamp(34px,6vw,56px);font-weight:800;letter-spacing:-.02em;line-height:1.08}
  h1 .hl{color:var(--accent)}
  .sub{margin:20px auto 0;max-width:640px;color:var(--ink-dim);font-size:16px}
  .src{margin-top:18px;font-family:var(--mono);font-size:11px;color:var(--ink-faint)}

  /* ---- sticky nav ---- */
  nav{position:sticky;top:0;z-index:20;background:rgba(14,16,20,.82);backdrop-filter:blur(10px);
      border-bottom:1px solid var(--line);padding:12px 0}
  nav .wrap{display:flex;gap:6px;flex-wrap:wrap;justify-content:center}
  nav a{font-size:12.5px;color:var(--ink-dim);text-decoration:none;padding:5px 11px;border-radius:99px;
        border:1px solid transparent;transition:.15s;font-family:var(--mono)}
  nav a:hover{color:var(--ink);border-color:var(--line);background:var(--panel)}

  /* ---- sections ---- */
  section{padding:56px 0 12px}
  .eyebrow{display:flex;align-items:center;gap:12px;margin-bottom:22px}
  .eyebrow .no{font-family:var(--mono);font-size:13px;color:var(--accent);font-weight:700}
  .eyebrow h2{font-size:25px;font-weight:750;letter-spacing:-.01em}
  .eyebrow .line{flex:1;height:1px;background:var(--line)}

  .panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:26px}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  @media(max-width:720px){.grid2{grid-template-columns:1fr}nav{display:none}}

  p{color:var(--ink-dim);margin:10px 0}
  p strong,.ink{color:var(--ink)}
  .accent{color:var(--accent)}
  .gold{color:var(--gold)}
  .cyan{color:var(--cyan)}
  .violet{color:var(--violet)}
  .green{color:var(--green)}

  .quote{border-left:3px solid var(--gold);padding:6px 0 6px 18px;margin:16px 0;color:var(--ink);
          font-size:16px;font-style:italic}
  .quote .en{display:block;color:var(--ink-faint);font-style:normal;font-size:13px;margin-top:6px;font-family:var(--mono)}

  pre{background:#0a0c10;border:1px solid var(--line);border-radius:12px;padding:18px 20px;overflow:auto;
      font-family:var(--mono);font-size:13px;line-height:1.75;color:var(--ink);margin:14px 0}
  pre .c{color:var(--ink-faint)}
  pre .a{color:var(--accent)}
  pre .g{color:var(--gold)}
  pre .cy{color:var(--cyan)}
  pre .v{color:var(--violet)}

  .cards{display:grid;gap:14px}
  .card{background:var(--panel-2);border:1px solid var(--line);border-radius:13px;padding:18px 20px}
  .card h4{font-size:16px;margin-bottom:6px;display:flex;align-items:center;gap:9px}
  .badge{font-family:var(--mono);font-size:11px;padding:2px 8px;border-radius:6px;font-weight:700}
  .b-heart{background:rgba(255,91,73,.14);color:var(--accent);border:1px solid rgba(255,91,73,.35)}
  .b-pipe{background:rgba(90,209,200,.12);color:var(--cyan);border:1px solid rgba(90,209,200,.3)}
  .b-lock{background:rgba(246,196,83,.12);color:var(--gold);border:1px solid rgba(246,196,83,.3)}
  .card p{margin:4px 0 0;font-size:14px}

  /* causal chain */
  .chain{display:flex;align-items:stretch;gap:0;flex-wrap:wrap;margin:8px 0}
  .chain .node{flex:1;min-width:150px;background:var(--panel-2);border:1px solid var(--line);
    border-radius:12px;padding:16px 14px;text-align:center;position:relative}
  .chain .node .t{font-weight:700;font-size:15px}
  .chain .node .d{font-size:12px;color:var(--ink-faint);margin-top:4px}
  .chain .arrow{display:flex;align-items:center;color:var(--accent);font-size:22px;padding:0 6px}
  @media(max-width:720px){.chain .arrow{transform:rotate(90deg);justify-content:center;width:100%;padding:4px 0}}

  /* checklist */
  .check{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  @media(max-width:720px){.check{grid-template-columns:1fr}}

  .check .it{display:flex;gap:12px;align-items:flex-start;background:var(--panel-2);border:1px solid var(--line);border-radius:11px;padding:14px 16px}
  .check .it .n{font-family:var(--mono);color:var(--green);font-weight:700;flex-shrink:0}
  .check .it b{display:block;color:var(--ink);font-size:14.5px}
  .check .it span{font-size:12.5px;color:var(--ink-faint)}

  /* steps */
  .steps{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:6px 0}
  .step{background:var(--panel-2);border:1px solid var(--line);border-radius:10px;padding:11px 16px;
        font-family:var(--mono);font-size:13px;font-weight:600}
  .step.hot{border-color:rgba(255,91,73,.5);color:var(--accent);box-shadow:0 0 0 1px rgba(255,91,73,.2) inset}
  .sep{color:var(--ink-faint)}

  .takeaway{background:linear-gradient(135deg,rgba(157,140,255,.1),rgba(255,91,73,.06));
    border:1px solid rgba(157,140,255,.35);border-radius:16px;padding:26px 28px;margin-top:8px}
  .takeaway .tag{font-family:var(--mono);font-size:11px;letter-spacing:.2em;color:var(--violet);text-transform:uppercase}
  .takeaway p{color:var(--ink);font-size:17px;margin-top:10px}
  .big{font-size:21px;font-weight:750;color:#fff;line-height:1.45}

  footer{text-align:center;margin-top:60px;padding-top:28px;border-top:1px solid var(--line);
    color:var(--ink-faint);font-size:12.5px;font-family:var(--mono)}
</style>

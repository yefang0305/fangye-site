---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="AI 工具实验室" description="记录 AI 工具、自动化工作流和效率实验，也发布一些自己做的小工具。">
  <!-- Ambient Decorative Glows -->
  <div class="ambient-glow glow-1"></div>
  <div class="ambient-glow glow-2"></div>

  <div class="home-container">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="avatar-wrapper">
        <div class="avatar-ring-spin"></div>
        <div class="avatar-ring-dashed"></div>
        <div class="avatar-container">
          <!-- Custom Vector Beaker SVG for "AI Tools Lab" -->
          <svg class="avatar-svg" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Beaker Silhouette -->
            <path d="M42 24H58" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M45 24V34L28 72C25 79 30 85 38 85H62C70 85 75 79 72 72L55 34V24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            
            <!-- Neural network connections inside the beaker -->
            <line x1="38" y1="68" x2="48" y2="52" stroke="currentColor" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.6"/>
            <line x1="48" y1="52" x2="62" y2="60" stroke="currentColor" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.6"/>
            <line x1="62" y1="60" x2="52" y2="76" stroke="currentColor" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.6"/>
            <line x1="52" y1="76" x2="38" y2="68" stroke="currentColor" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.6"/>
            <line x1="48" y1="52" x2="52" y2="76" stroke="currentColor" stroke-width="1" opacity="0.4"/>
            <line x1="38" y1="68" x2="62" y2="60" stroke="currentColor" stroke-width="1" opacity="0.4"/>
            
            <!-- Glowing Network Nodes -->
            <circle cx="48" cy="52" r="2.5" fill="currentColor" class="node-pulse-1"/>
            <circle cx="62" cy="60" r="2.5" fill="currentColor" class="node-pulse-2"/>
            <circle cx="38" cy="68" r="2" fill="currentColor" class="node-pulse-3"/>
            <circle cx="52" cy="76" r="3" fill="currentColor" class="node-pulse-1"/>
            
            <!-- Drifting ideas (Bubbles/Sparks) floating out of the beaker -->
            <circle cx="46" cy="15" r="1.5" fill="currentColor" class="bubble-float-1"/>
            <circle cx="54" cy="10" r="1" fill="currentColor" class="bubble-float-2"/>
            <circle cx="50" cy="19" r="2" fill="currentColor" class="bubble-float-3"/>
          </svg>
        </div>
      </div>
      
      <h1 class="hero-title">AI 工具实验室</h1>
      <p class="hero-subtitle">记录 AI 工具、自动化工作流和效率实验，也发布一些自己做的小工具。</p>
    </section>

    <!-- Navigation Portal Grid -->
    <section class="cards-grid" id="interactive-grid">
      
      <!-- Card 1: Articles -->
      <article class="grid-card">
        <div class="card-glow"></div>
        <div class="card-content">
          <div class="card-icon-container">
            <!-- Document Icon -->
            <svg class="card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <h2 class="card-title">文章专栏</h2>
          <p class="card-desc">AI 工具评测、组合方式、提示词工程与使用经验分享。</p>
          <a href="/articles/" class="card-link">
            <span>阅读文章</span>
            <svg class="link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </article>

      <!-- Card 2: Tools -->
      <article class="grid-card">
        <div class="card-glow"></div>
        <div class="card-content">
          <div class="card-icon-container">
            <!-- Terminal/Code Icon -->
            <svg class="card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="4 17 10 11 4 5"></polyline>
              <line x1="12" y1="19" x2="20" y2="19"></line>
            </svg>
          </div>
          <h2 class="card-title">在线工具</h2>
          <p class="card-desc">站内可直接使用的文本处理、网页生成及公众号排版小工具。</p>
          <a href="/tools/" class="card-link">
            <span>立即使用</span>
            <svg class="link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </article>

      <!-- Card 3: Projects -->
      <article class="grid-card">
        <div class="card-glow"></div>
        <div class="card-content">
          <div class="card-icon-container">
            <!-- Layers Icon (Projects) -->
            <svg class="card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <h2 class="card-title">项目专栏</h2>
          <p class="card-desc">文案视频流水线、多账号发布、桌面悬浮笔记等独立项目展示。</p>
          <a href="/projects/" class="card-link">
            <span>查看项目</span>
            <svg class="link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </article>

      <!-- Card 4: About -->
      <article class="grid-card">
        <div class="card-glow"></div>
        <div class="card-content">
          <div class="card-icon-container">
            <!-- User/Profile Icon -->
            <svg class="card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
          <h2 class="card-title">关于作者</h2>
          <p class="card-desc">AI 产品经理的个人简历、工作经历、技术栈与合作联系方式。</p>
          <a href="/about/" class="card-link">
            <span>了解关于</span>
            <svg class="link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </article>

    </section>
  </div>
</BaseLayout>

<!-- client-side javascript for card cursor glow effect -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.grid-card');
    const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;

    if (!isTouchDevice) {
      cards.forEach(card => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;

          card.style.setProperty('--mouse-x', `${x}px`);
          card.style.setProperty('--mouse-y', `${y}px`);
        });

        card.addEventListener('mouseleave', () => {
          card.style.removeProperty('--mouse-x');
          card.style.removeProperty('--mouse-y');
        });
      });
    }
  });
</script>

<!-- Scoped Styles for Homepage layout -->
<style>
  /* ==========================================================================
     LAYOUT STYLING
     ========================================================================== */
  .home-container {
    max-width: 1000px;
    width: 100%;
    margin: 0 auto;
    padding: 3rem 0 5rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  /* Ambient glowing backgrounds mapping to green/teal branding color */
  .ambient-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(140px);
    z-index: 1;
    pointer-events: none;
    opacity: 0.6;
  }

  .glow-1 {
    width: 40vw;
    height: 40vw;
    max-width: 500px;
    background: rgba(71, 214, 178, 0.08); /* signature mint color */
    top: 5%;
    left: 10%;
    animation: drift 25s ease-in-out infinite alternate;
  }

  .glow-2 {
    width: 35vw;
    height: 35vw;
    max-width: 400px;
    background: rgba(164, 240, 218, 0.06);
    bottom: 10%;
    right: 15%;
    animation: drift 20s ease-in-out infinite alternate-reverse;
  }

  @keyframes drift {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(6%, 10%) scale(1.1); }
  }

  /* ==========================================================================
     HERO & AVATAR CUSTOM DESIGN
     ========================================================================== */
  .hero-section {
    text-align: center;
    margin-bottom: 4.5rem;
    max-width: 620px;
    position: relative;
  }

  .avatar-wrapper {
    position: relative;
    width: 116px;
    height: 116px;
    margin: 0 auto 2.25rem auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .avatar-ring-dashed {
    position: absolute;
    inset: -8px;
    border: 1px dashed rgba(164, 240, 218, 0.15);
    border-radius: 50%;
    pointer-events: none;
  }

  .avatar-ring-spin {
    position: absolute;
    inset: -14px;
    border: 1.5px solid transparent;
    border-top-color: var(--accent-strong);
    border-bottom-color: var(--accent-strong);
    border-radius: 50%;
    opacity: 0.3;
    animation: spin 16s linear infinite;
  }

  .avatar-container {
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, rgba(20, 33, 40, 0.95) 0%, rgba(11, 17, 22, 0.8) 100%);
    border: 1px solid var(--line);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.45);
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease;
  }

  .avatar-wrapper:hover .avatar-container {
    border-color: var(--accent-strong);
    transform: scale(1.03);
    box-shadow: 0 15px 45px rgba(71, 214, 178, 0.12);
  }

  .avatar-svg {
    width: 60%;
    height: 60%;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .avatar-wrapper:hover .avatar-svg {
    transform: scale(1.06);
    color: var(--accent-strong);
  }

  /* Animated elements inside SVG Beaker */
  .node-pulse-1 { animation: pulse 2s ease-in-out infinite; }
  .node-pulse-2 { animation: pulse 2s ease-in-out infinite 0.6s; }
  .node-pulse-3 { animation: pulse 2s ease-in-out infinite 1.2s; }

  .bubble-float-1 { animation: float 3s ease-in-out infinite; }
  .bubble-float-2 { animation: float 4.2s ease-in-out infinite 0.8s; }
  .bubble-float-3 { animation: float 2.5s ease-in-out infinite 0.4s; }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.5; r: 1.8px; }
    50% { opacity: 1; r: 3.2px; filter: drop-shadow(0 0 3px var(--accent-strong)); }
  }

  @keyframes float {
    0% { transform: translateY(5px); opacity: 0; }
    50% { opacity: 0.8; }
    100% { transform: translateY(-7px); opacity: 0; }
  }

  /* Title and Subtitle */
  .hero-title {
    font-size: 2.35rem;
    font-weight: 780;
    letter-spacing: -0.01em;
    margin-bottom: 1.15rem;
    color: var(--text);
    background: linear-gradient(135deg, #ffffff 0%, #a9bbb6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 1.05rem;
    font-weight: 350;
    color: var(--muted);
    line-height: 1.7;
    letter-spacing: 0.04em;
    padding: 0 1.5rem;
  }

  /* ==========================================================================
     CARDS GRID SYSTEM
     ========================================================================== */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    width: 100%;
  }

  .grid-card {
    position: relative;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(20, 33, 40, 0.65) 0%, rgba(13, 22, 27, 0.75) 100%);
    border: 1px solid var(--line);
    overflow: hidden;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease, box-shadow 0.4s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .grid-card:hover {
    transform: translateY(-4px);
    border-color: var(--line-strong);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4), 0 0 15px rgba(159, 245, 215, 0.02);
  }

  /* Card Cursor Glow Highlight effect */
  .card-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      circle 160px at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(71, 214, 178, 0.07),
      transparent 80%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 1;
  }

  .grid-card:hover .card-glow {
    opacity: 1;
  }

  .card-content {
    padding: 2.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    z-index: 2;
  }

  .card-icon-container {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background-color: rgba(159, 245, 215, 0.05);
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    margin-bottom: 1.6rem;
    transition: color 0.4s ease, border-color 0.4s ease, background-color 0.4s ease;
  }

  .grid-card:hover .card-icon-container {
    color: var(--accent-strong);
    border-color: var(--line-strong);
    background-color: rgba(159, 245, 215, 0.1);
  }

  .card-icon {
    width: 20px;
    height: 20px;
  }

  .card-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--text);
  }

  .card-desc {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.6;
    font-weight: 350;
    margin-bottom: 2rem;
    flex-grow: 1;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.875rem;
    font-weight: 650;
    color: var(--accent);
    width: fit-content;
    transition: color 0.2s ease;
  }

  .link-arrow {
    width: 14px;
    height: 14px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .grid-card:hover .card-link {
    color: var(--accent-strong);
  }

  .grid-card:hover .link-arrow {
    transform: translateX(4px);
  }

  /* Style override for layout base components (site header & footer) on home page */
  :global(.site-header) {
    border-bottom: 1px solid var(--line);
    margin-bottom: 0 !important;
    padding: 16px 0 !important;
  }

  :global(.site-nav a) {
    font-weight: 600;
  }

  :global(.site-footer) {
    border-top: 1px solid var(--line);
    margin-top: 5rem !important;
    padding: 30px 0 !important;
  }

  /* ==========================================================================
     RESPONSIVE BREAKPOINTS
     ========================================================================== */
  @media (max-width: 900px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
    
    .hero-section {
      margin-bottom: 3.5rem;
    }
  }

  @media (max-width: 600px) {
    .cards-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    
    .hero-section {
      margin-bottom: 2.75rem;
    }

    .hero-title {
      font-size: 1.95rem;
    }

    .hero-subtitle {
      font-size: 0.95rem;
      padding: 0;
    }
    
    .card-content {
      padding: 2rem 1.5rem;
    }
  }
</style>

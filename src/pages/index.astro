---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { tools } from '../data/tools';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredArticles = articles.filter((article) => article.data.featured).slice(0, 2);
const latestArticles = articles.slice(0, 4);
const featuredTools = tools.filter((tool) => tool.status === 'usable' && tool.featured).slice(0, 3);
const featuredProjects = tools.filter((tool) => tool.status === 'showcase' && tool.featured).slice(0, 2);

const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});

const stats = [
  { value: `${articles.length}+`, label: '篇 AI 实战文章' },
  { value: `${tools.filter((tool) => tool.status === 'usable').length}`, label: '个站内可用工具' },
  { value: '3', label: '套 Agent 工程课程' },
];

const entryCards = [
  {
    eyebrow: 'Read',
    title: '文章',
    description: '从 AI Agent、编程工具到普通人的工作流机会，记录真实使用后的判断。',
    href: '/articles/',
    action: '进入文章库',
  },
  {
    eyebrow: 'Use',
    title: '工具',
    description: '文本清理、公众号排版、数学可视化、TTS 字幕等打开就能用的小工具。',
    href: '/tools/',
    action: '打开工具箱',
  },
  {
    eyebrow: 'Build',
    title: '项目',
    description: '短视频自动化、多账号发布、节点画布和桌面效率工具的开发记录。',
    href: '/projects/',
    action: '查看项目',
  },
  {
    eyebrow: 'Learn',
    title: '课程',
    description: '把 Agent 外壳、循环控制和上下文工程拆成可以一步步通关的课程。',
    href: '/courses/',
    action: '开始学习',
  },
];

const courseTracks = [
  {
    title: 'Harness Engineering',
    description: '从裸模型消息列表开始，理解工具调用、记忆、上下文与可靠性验证。',
    href: '/courses/harness-engineering/',
  },
  {
    title: 'Loop Engineering',
    description: '拆解 ReAct、Plan、反思、停止条件与长程任务控制。',
    href: '/courses/loop-engineering/',
  },
  {
    title: 'Context Engineering',
    description: '研究裁剪、压缩、检索和外部记忆，降低爆窗与注意力污染。',
    href: '/courses/context-engineering/',
  },
];
---

<BaseLayout title="AI 工具实验室" description="记录 AI 工具、自动化工作流和效率实验，也发布一些自己做的小工具。">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="eyebrow">fangye.cc / AI 工具实验室</p>
      <h1 id="home-title">AI 工具实验室</h1>
      <p class="lead">
        记录 AI 工具、Agent 工程与自动化工作流。
        文章、课程和小工具都放在这里。
      </p>
      <div class="hero-actions" aria-label="首页主要入口">
        <a class="primary-link" href="/articles/">阅读最新文章</a>
        <a class="secondary-link" href="/tools/">使用在线工具</a>
      </div>
    </div>

    <aside class="hero-dashboard" aria-label="网站内容概览">
      <div class="dashboard-header">
        <span class="signal-dot" aria-hidden="true"></span>
        <span>当前更新方向</span>
      </div>
      <div class="focus-list">
        <a href="/articles/agent-beginner-tutorial/" class="focus-item">
          <span>01</span>
          <strong>Agent 入门</strong>
          <small>从聊天框到数字员工</small>
        </a>
        <a href="/courses/" class="focus-item">
          <span>02</span>
          <strong>工程课程</strong>
          <small>脚手架、循环与上下文</small>
        </a>
        <a href="/projects/shortvideo-automation-suite/" class="focus-item">
          <span>03</span>
          <strong>自动化项目</strong>
          <small>内容生产工作流实验</small>
        </a>
      </div>
      <div class="stat-row">
        {stats.map((stat) => (
          <div>
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </div>
        ))}
      </div>
    </aside>
  </section>

  <section class="page-section home-section" aria-labelledby="entry-title">
    <div class="section-heading">
      <p class="eyebrow">Start Here</p>
      <h2 id="entry-title">你可以从这里进入</h2>
      <p>如果是第一次来，先按目的选择入口；如果已经熟悉，可以直接去最新内容。</p>
    </div>

    <div class="entry-grid">
      {entryCards.map((card) => (
        <a class="entry-card" href={card.href}>
          <span class="entry-eyebrow">{card.eyebrow}</span>
          <h3>{card.title}</h3>
          <p>{card.description}</p>
          <span class="entry-action">{card.action}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="page-section home-section content-layout" aria-labelledby="latest-title">
    <div class="section-heading">
      <p class="eyebrow">Latest</p>
      <h2 id="latest-title">最近写的东西</h2>
      <p>围绕 AI 工具、Agent、普通人的机会和真实工作流，持续把观察沉淀成文章。</p>
    </div>

    <div class="article-board">
      <div class="featured-articles">
        {featuredArticles.map((article) => (
          <a class="featured-article" href={`/articles/${article.slug}/`}>
            <span>{dateFormatter.format(article.data.pubDate)}</span>
            <h3>{article.data.title}</h3>
            <p>{article.data.description}</p>
            <div class="tag-row">
              {article.data.tags.slice(0, 3).map((tag) => <em>#{tag}</em>)}
            </div>
          </a>
        ))}
      </div>

      <div class="latest-list">
        {latestArticles.map((article) => (
          <a href={`/articles/${article.slug}/`} class="latest-row">
            <time datetime={article.data.pubDate.toISOString()}>{dateFormatter.format(article.data.pubDate)}</time>
            <span>{article.data.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section home-section tools-projects" aria-labelledby="tools-title">
    <div class="section-heading compact">
      <p class="eyebrow">Tools & Projects</p>
      <h2 id="tools-title">能直接用，也能看我是怎么做的</h2>
    </div>

    <div class="split-panels">
      <div class="mini-panel">
        <div class="panel-title-row">
          <h3>站内工具</h3>
          <a href="/tools/">全部工具</a>
        </div>
        <div class="mini-list">
          {featuredTools.map((tool) => (
            <a href={tool.href}>
              <strong>{tool.name}</strong>
              <span>{tool.description}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="mini-panel">
        <div class="panel-title-row">
          <h3>项目展示</h3>
          <a href="/projects/">全部项目</a>
        </div>
        <div class="mini-list">
          {featuredProjects.map((project) => (
            <a href={project.href}>
              <strong>{project.name}</strong>
              <span>{project.description}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="page-section home-section course-strip" aria-labelledby="course-title">
    <div class="section-heading compact">
      <p class="eyebrow">Courses</p>
      <h2 id="course-title">把 Agent 工程拆开学</h2>
    </div>

    <div class="course-grid">
      {courseTracks.map((course) => (
        <a class="course-tile" href={course.href}>
          <h3>{course.title}</h3>
          <p>{course.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero,
  .home-section {
    width: min(var(--max), calc(100% - 40px));
    margin-inline: auto;
  }

  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(340px, 0.95fr);
    gap: 40px;
    align-items: center;
    padding: 70px 0 50px;
  }

  .hero-copy h1 {
    max-width: 760px;
    margin-bottom: 18px;
    font-size: clamp(44px, 6vw, 68px);
  }

  .hero-copy .lead {
    max-width: 620px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .primary-link,
  .secondary-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 16px;
    border-radius: var(--radius);
    font-size: 15px;
    font-weight: 720;
  }

  .primary-link {
    color: var(--bg);
    background: var(--accent);
  }

  .primary-link:hover,
  .primary-link:focus-visible {
    background: var(--accent-strong);
  }

  .secondary-link {
    border: 1px solid var(--line);
    color: var(--text);
    background: rgba(255, 255, 255, 0.035);
  }

  .secondary-link:hover,
  .secondary-link:focus-visible {
    border-color: var(--line-strong);
    background: rgba(159, 245, 215, 0.07);
  }

  .hero-dashboard,
  .mini-panel {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background:
      linear-gradient(135deg, rgba(25, 43, 50, 0.84), rgba(13, 22, 27, 0.9)),
      radial-gradient(circle at top right, rgba(159, 245, 215, 0.12), transparent 18rem);
    box-shadow: 0 24px 60px var(--shadow);
  }

  .hero-dashboard {
    padding: 22px;
  }

  .dashboard-header,
  .panel-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .dashboard-header {
    justify-content: flex-start;
    margin-bottom: 16px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 700;
  }

  .signal-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--accent-strong);
    box-shadow: 0 0 18px var(--accent-strong);
  }

  .focus-list {
    display: grid;
    gap: 10px;
  }

  .focus-item {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    gap: 10px 14px;
    padding: 14px;
    border: 1px solid rgba(164, 240, 218, 0.12);
    border-radius: var(--radius);
    background: rgba(11, 17, 22, 0.34);
  }

  .focus-item:hover,
  .focus-item:focus-visible {
    border-color: var(--line-strong);
    background: rgba(159, 245, 215, 0.06);
  }

  .focus-item span {
    grid-row: span 2;
    color: var(--accent);
    font-size: 13px;
    font-weight: 780;
  }

  .focus-item strong {
    color: var(--text);
    font-size: 17px;
  }

  .focus-item small {
    color: var(--subtle);
    font-size: 13px;
  }

  .stat-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .stat-row strong,
  .stat-row span {
    display: block;
  }

  .stat-row strong {
    color: var(--accent);
    font-size: 22px;
  }

  .stat-row span {
    margin-top: 4px;
    color: var(--subtle);
    font-size: 12px;
    line-height: 1.45;
  }

  .section-heading {
    max-width: 700px;
    margin-bottom: 24px;
  }

  .section-heading.compact {
    max-width: 760px;
  }

  .section-heading p {
    margin-bottom: 0;
  }

  .entry-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .entry-card,
  .featured-article,
  .course-tile {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(20, 33, 40, 0.58);
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .entry-card {
    padding: 18px;
  }

  .entry-card:hover,
  .entry-card:focus-visible,
  .featured-article:hover,
  .featured-article:focus-visible,
  .course-tile:hover,
  .course-tile:focus-visible {
    transform: translateY(-3px);
    border-color: var(--line-strong);
    background: rgba(25, 43, 50, 0.8);
  }

  .entry-eyebrow {
    margin-bottom: 18px;
    color: var(--accent);
    font-size: 12px;
    font-weight: 780;
    text-transform: uppercase;
  }

  .entry-card h3,
  .featured-article h3,
  .course-tile h3 {
    margin-bottom: 8px;
  }

  .entry-card p,
  .featured-article p,
  .course-tile p {
    margin-bottom: 16px;
    font-size: 14px;
    line-height: 1.65;
  }

  .entry-action {
    margin-top: auto;
    color: var(--accent);
    font-size: 14px;
    font-weight: 700;
  }

  .article-board {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
    gap: 18px;
  }

  .featured-articles {
    display: grid;
    gap: 16px;
  }

  .featured-article {
    padding: 20px;
  }

  .featured-article > span {
    margin-bottom: 12px;
    color: var(--subtle);
    font-size: 13px;
  }

  .tag-row em {
    color: var(--accent);
    font-size: 12px;
    font-style: normal;
  }

  .latest-list {
    border-top: 1px solid var(--line);
  }

  .latest-row {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .latest-row:hover span,
  .latest-row:focus-visible span {
    color: var(--accent);
  }

  .latest-row time {
    color: var(--subtle);
    font-size: 13px;
  }

  .latest-row span {
    color: var(--text);
    font-weight: 650;
    line-height: 1.45;
  }

  .split-panels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .mini-panel {
    padding: 20px;
  }

  .panel-title-row {
    margin-bottom: 14px;
  }

  .panel-title-row h3 {
    margin-bottom: 0;
  }

  .panel-title-row a {
    color: var(--accent);
    font-size: 13px;
    font-weight: 700;
  }

  .mini-list {
    display: grid;
    gap: 10px;
  }

  .mini-list a {
    display: grid;
    gap: 4px;
    padding: 12px 0;
    border-top: 1px solid rgba(164, 240, 218, 0.12);
  }

  .mini-list a:hover strong,
  .mini-list a:focus-visible strong {
    color: var(--accent);
  }

  .mini-list strong {
    color: var(--text);
    font-size: 16px;
  }

  .mini-list span {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .course-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .course-tile {
    padding: 18px;
  }

  @media (max-width: 980px) {
    .home-hero,
    .article-board,
    .split-panels {
      grid-template-columns: 1fr;
    }

    .entry-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .home-hero {
      padding: 46px 0 34px;
    }

    .hero-copy h1 {
      margin-bottom: 14px;
      font-size: 36px;
      line-height: 1.08;
    }

    .hero-copy .lead {
      font-size: 17px;
      line-height: 1.6;
    }

    .entry-grid,
    .course-grid,
    .stat-row {
      grid-template-columns: 1fr;
    }

    .latest-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { tools } from '../../data/tools';

const usableTools = tools.filter((tool) => tool.status === 'usable');
const showcaseTools = tools.filter((tool) => tool.status === 'showcase');
---

<BaseLayout title="工具" description="站内可用的小工具和项目展示。">
  <section class="page-hero">
    <p class="eyebrow">Tools</p>
    <h1>工具</h1>
    <p class="lead">简单工具可以直接在站内使用，复杂项目先以卡片形式记录和展示。</p>
  </section>
  <section class="page-section">
    <SectionHeader eyebrow="Usable" title="站内可用" description="打开就能用的小工具。" />
    <div class="tool-list">
      {usableTools.map((tool) => <ToolCard {...tool} />)}
    </div>
  </section>
  <section class="page-section">
    <SectionHeader eyebrow="Showcase" title="项目展示" description="还在整理或部署中的工具想法。" />
    <div class="tool-list">
      {showcaseTools.map((tool) => <ToolCard {...tool} />)}
    </div>
  </section>
</BaseLayout>

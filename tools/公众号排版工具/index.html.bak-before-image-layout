        const SYSTEM_PROMPT = `你是一位资深的公众号排版设计师，服务过生活、商业、科技、情感等多个领域的头部公众号。你的任务不是简单分类，而是把一篇文章"编排"出节奏感和层次感。

【核心排版原则】
1. **节奏感** — 文字需要呼吸。长段落必须拆成多段，每段不超过 3 句话。短句穿插长句，让阅读轻盈。
2. **层次感** — 用 divider / list / highlight 制造视觉起伏，避免从头到尾纯文字流水。
3. **精准强调** — 真正有力量的"金句"才用 highlight 整段放大；一般观点句在段落内用 **双星号** 标记关键词即可。
4. **关键词点睛** — 每个段落挑出 1-3 个最能体现情绪或观点的词，用 **关键词** 包裹，让视线跳跃有节奏。

【section 类型】
- heading1：一级标题（核心章节）
- heading2：二级小标题（子章节）
- paragraph：正文段落（**严格不超过 3 句话**，超长必须拆分为多个 paragraph）
- highlight：金句/整段级的重点突出（仅用于真正有冲击力的单句，不要滥用）
- quote：引用（他人原话、诗文、文献）
- summary：全文总结段（通常在文末）
- tip：小贴士、注意事项
- divider：装饰分隔符，content 可为空字符串或简短装饰文字（如 "01"、"· 正文 ·"）。在章节过渡处插入
- list：列表，数据形如 { "type": "list", "style": "ordered" | "unordered", "items": ["...", "..."] }

【关键词强调语法】
在 paragraph / highlight / summary / tip / list.items 的文本中，用 **双星号** 包裹关键词。
例："谷雨一到，**雨不再迷离**，一颗颗**清澈干净**的雨滴从天空降落。"

【输出格式】严格 JSON，不要任何前后说明文字，不要代码块包裹：
{
  "title": "...",
  "sections": [ { "type": "...", "content": "..." }, ... ]
}

【编排示范】
输入原文："今天是谷雨。谷雨前，春雨还如云雾般细腻柔和。谷雨一到，雨不再迷离。好春莫虚度，从眼前出发，只要勤奋向上，总有丰收在望。在铺满落花的幽径上走一走，一瓣芳菲，一段记忆。"
优秀编排输出：
{
  "title": "谷雨：不负春日好时光",
  "sections": [
    { "type": "paragraph", "content": "今天是**谷雨**。" },
    { "type": "paragraph", "content": "谷雨前，春雨还如**云雾般细腻柔和**。" },
    { "type": "paragraph", "content": "谷雨一到，**雨不再迷离**，一颗颗清澈干净的雨滴从天空降落。" },
    { "type": "divider", "content": "" },
    { "type": "highlight", "content": "好春莫虚度，从眼前出发，**只要勤奋向上**，总有丰收在望。" },
    { "type": "paragraph", "content": "在铺满落花的幽径上走一走，**一瓣芳菲，一段记忆**。" }
  ]
}

【铁律】
- 只返回 JSON，禁止任何额外文字或代码块包裹
- 保持原文完整性和准确性，不删减、不编造、不改写
- 段落必须短促，有明显的节奏断句
- 合理插入 divider 作为章节过渡（一篇文章通常有 1-3 个 divider）
- 关键词标记要节制，挑最能打动人的词`;

        // 初始化
        document.addEventListener('DOMContentLoaded', () => {
            // 加载本地存储的配置
            loadConfig();

            // 绑定事件
            bindEvents();

            // 默认选中第一个主题
            selectTheme('business');
        });

        // 加载配置
        function loadConfig() {
            const apiKey = localStorage.getItem('wechat_editor_apiKey');
            const baseURL = localStorage.getItem('wechat_editor_baseURL');
            const modelId = localStorage.getItem('wechat_editor_modelId');
            const savedTheme = localStorage.getItem('wechat_editor_theme');

            if (apiKey) document.getElementById('apiKey').value = apiKey;
            if (baseURL) document.getElementById('baseURL').value = baseURL;
            if (modelId) document.getElementById('modelId').value = modelId;
            if (savedTheme) selectTheme(savedTheme);
        }

        // 保存配置
        function saveConfig() {
            const apiKey = document.getElementById('apiKey').value;
            const baseURL = document.getElementById('baseURL').value;
            const modelId = document.getElementById('modelId').value;

            if (apiKey) localStorage.setItem('wechat_editor_apiKey', apiKey);
            if (baseURL) localStorage.setItem('wechat_editor_baseURL', baseURL);
            if (modelId) localStorage.setItem('wechat_editor_modelId', modelId);
            localStorage.setItem('wechat_editor_theme', currentTheme);
        }

        // 绑定事件
        function bindEvents() {
            // API Key显示切换
            document.getElementById('toggleApiKey').addEventListener('click', toggleApiKeyVisibility);

            // 主题选择
            document.querySelectorAll('.theme-card').forEach(card => {
                card.addEventListener('click', () => {
                    const theme = card.dataset.theme;
                    selectTheme(theme);
                });
            });

            // 字数统计
            document.getElementById('contentInput').addEventListener('input', updateWordCount);

            // 排版按钮
            document.getElementById('formatBtn').addEventListener('click', formatContent);

            // 清空按钮
            document.getElementById('clearBtn').addEventListener('click', clearContent);

            // 复制富文本
            document.getElementById('copyRichBtn').addEventListener('click', copyRichText);

            // 复制源码
            document.getElementById('copyHtmlBtn').addEventListener('click', copyHtmlSource);
        }

        // 切换API Key可见性
        function toggleApiKeyVisibility() {
            const input = document.getElementById('apiKey');
            const icon = document.getElementById('toggleApiKey').querySelector('i');

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            }
        }

        // 选择主题
        function selectTheme(theme) {
            currentTheme = theme;

            // 更新UI状态
            document.querySelectorAll('.theme-card').forEach(card => {
                if (card.dataset.theme === theme) {
                    card.classList.add('border-primary', 'bg-primary/5');
                    card.classList.remove('border-gray-200');
                } else {
                    card.classList.remove('border-primary', 'bg-primary/5');
                    card.classList.add('border-gray-200');
                }
            });

            // 保存配置
            saveConfig();

            // 如果已有排版结果，重新生成并渲染
            if (lastResult) {
                generateHtml(lastResult);
                renderPreview();
            }
        }

        // 更新字数统计
        function updateWordCount() {
            const content = document.getElementById('contentInput').value;
            const count = content.length;
            document.getElementById('wordCount').textContent = count;
        }

        // 清空内容
        function clearContent() {
            document.getElementById('contentInput').value = '';
            updateWordCount();
            document.getElementById('previewArea').innerHTML = `
                <div class="text-center text-gray-400 py-12">
                    <i class="fa fa-file-text-o text-4xl mb-3"></i>
                    <p>输入内容后点击「智能排版」，预览将显示在这里</p>
                </div>
            `;
            formattedHtml = '';
            lastResult = null;
        }

        // 智能排版
        async function formatContent() {
            const content = document.getElementById('contentInput').value.trim();
            const apiKey = document.getElementById('apiKey').value.trim();
            const baseURL = document.getElementById('baseURL').value.trim();
            const modelId = document.getElementById('modelId').value.trim();

            // 验证输入
            if (!content) {
                showToast('请先输入文章内容', 'warning');
                return;
            }

            if (!apiKey) {
                showToast('请输入豆包 API Key', 'warning');
                return;
            }

            if (!modelId) {
                showToast('请输入模型 ID', 'warning');
                return;
            }

            // 保存配置
            saveConfig();

            // 显示加载
            showLoading(true);

            try {
                // 通过本地 Python 代理转发,避免浏览器 CORS 拦截,API Key 不经过第三方
                const response = await fetch('/api/format', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        baseURL: baseURL,
                        apiKey: apiKey,
                        model: modelId,
                        messages: [
                            { role: 'system', content: SYSTEM_PROMPT },
                            { role: 'user', content: content }
                        ],
                        temperature: 0.3
                    })
                });

                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.error?.message || `API请求失败，状态码：${response.status}`);
                }

                const data = await response.json();
                const rawContent = data.choices[0].message.content;
                // 兼容模型返回 ```json ... ``` 代码块的情况
                const jsonText = rawContent.replace(/^```(?:json)?\s*/i, '').replace(/\s*```$/, '').trim();
                const result = JSON.parse(jsonText);
                lastResult = result;

                // 生成HTML
                generateHtml(result);

                // 渲染预览
                renderPreview();

                showToast('排版完成', 'success');
            } catch (error) {
                console.error('排版失败:', error);
                let errorMessage = error.message;
                if (errorMessage.includes('Failed to fetch')) {
                    errorMessage = '无法连接到本地服务,请确认已通过「启动.bat」运行 server.py';
                }
                showToast(`排版失败：${errorMessage}`, 'error');
            } finally {
                showLoading(false);
            }
        }

        // 段落内富文本处理:转义 + **关键词** + 换行
        function formatInline(text, theme) {
            if (text == null) return '';
            let html = escapeHtml(String(text));
            // **关键词** → 高亮 span(非贪婪,不跨行)
            html = html.replace(/\*\*([^*\n]+?)\*\*/g, `<span style="${theme.keyword}">$1</span>`);
            html = html.replace(/\r?\n/g, '<br>');
            return html;
        }

        // 生成HTML
        function generateHtml(data) {
            const theme = themes[currentTheme];
            let html = '';

            if (data.title) {
                html += `<h1 style="${theme.title}">${formatInline(data.title, theme)}</h1>`;
            }

            if (data.sections && Array.isArray(data.sections)) {
                data.sections.forEach(section => {
                    const type = section.type;

                    // 分隔符:空 content 时用主题默认装饰
                    if (type === 'divider') {
                        const raw = (section.content || '').trim();
                        const label = raw ? formatInline(raw, theme) : theme.dividerDefault;
                        html += `<section style="${theme.divider}">${label}</section>`;
                        return;
                    }

                    // 列表
                    if (type === 'list') {
                        const tag = section.style === 'ordered' ? 'ol' : 'ul';
                        const items = (section.items || []).map(item =>
                            `<li style="${theme.listItem}">${formatInline(item, theme)}</li>`
                        ).join('');
                        html += `<${tag} style="${theme.list}">${items}</${tag}>`;
                        return;
                    }

                    // 文本类型统一走 formatInline
                    const content = formatInline(section.content, theme);

                    switch (type) {
                        case 'heading1':
                            html += `<h2 style="${theme.heading1}">${content}</h2>`;
                            break;
                        case 'heading2':
                            html += `<h3 style="${theme.heading2}">${content}</h3>`;
                            break;
                        case 'highlight':
                            html += `<section style="${theme.highlight}">${content}</section>`;
                            break;
                        case 'quote':
                            html += `<section style="${theme.quote}">${content}</section>`;
                            break;
                        case 'summary':
                            html += `<section style="${theme.summary}">${content}</section>`;
                            break;
                        case 'tip':
                            html += `<section style="${theme.tip}">${content}</section>`;
                            break;
                        case 'paragraph':
                        default:
                            html += `<p style="${theme.paragraph}">${content}</p>`;
                            break;
                    }
                });
            }

            formattedHtml = html;
        }

        // 渲染预览
        function renderPreview() {
            document.getElementById('previewArea').innerHTML = formattedHtml;
        }

        // 复制富文本
        async function copyRichText() {
            if (!formattedHtml) {
                showToast('没有可复制的内容，请先进行排版', 'warning');
                return;
            }

            try {
                const plainText = document.getElementById('previewArea').innerText || '';
                const htmlBlob = new Blob([formattedHtml], { type: 'text/html' });
                const textBlob = new Blob([plainText], { type: 'text/plain' });
                const clipboardItem = new ClipboardItem({
                    'text/html': htmlBlob,
                    'text/plain': textBlob
                });
                await navigator.clipboard.write([clipboardItem]);

                showToast('富文本已复制到剪贴板', 'success');

                // 按钮反馈
                const btn = document.getElementById('copyRichBtn');
                const originalText = btn.innerHTML;
                btn.innerHTML = '<i class="fa fa-check mr-1"></i> 已复制';
                btn.classList.add('bg-green-600');
                setTimeout(() => {
                    btn.innerHTML = originalText;
                    btn.classList.remove('bg-green-600');
                }, 2000);
            } catch (error) {
                console.error('复制失败:', error);
                showToast('复制失败，请重试', 'error');
            }
        }

        // 复制HTML源码
        async function copyHtmlSource() {
            if (!formattedHtml) {
                showToast('没有可复制的内容，请先进行排版', 'warning');
                return;
            }

            try {
                await navigator.clipboard.writeText(formattedHtml);
                showToast('HTML源码已复制到剪贴板', 'success');

                // 按钮反馈
                const btn = document.getElementById('copyHtmlBtn');
                const originalText = btn.innerHTML;
                btn.innerHTML = '<i class="fa fa-check mr-1"></i> 已复制';
                btn.classList.add('bg-green-600');
                setTimeout(() => {
                    btn.innerHTML = originalText;
                    btn.classList.remove('bg-green-600');
                }, 2000);
            } catch (error) {
                console.error('复制失败:', error);
                showToast('复制失败，请重试', 'error');
            }
        }

        // HTML转义
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // 显示/隐藏加载
        function showLoading(show) {
            const overlay = document.getElementById('loadingOverlay');
            const formatBtn = document.getElementById('formatBtn');
            if (show) {
                overlay.classList.remove('hidden');
                formatBtn.disabled = true;
                formatBtn.classList.add('opacity-60', 'cursor-not-allowed');
            } else {
                overlay.classList.add('hidden');
                formatBtn.disabled = false;
                formatBtn.classList.remove('opacity-60', 'cursor-not-allowed');
            }
        }

        // 显示提示
        function showToast(message, type = 'info') {
            const toast = document.getElementById('toast');
            const icon = document.getElementById('toastIcon');
            const messageEl = document.getElementById('toastMessage');

            // 设置类型样式
            switch (type) {
                case 'success':
                    toast.className = 'fixed top-4 right-4 px-4 py-2 rounded-lg shadow-lg transform transition-all duration-300 translate-x-0 z-50 flex items-center bg-success text-white';
                    icon.className = 'fa fa-check-circle mr-2';
                    break;
                case 'error':
                    toast.className = 'fixed top-4 right-4 px-4 py-2 rounded-lg shadow-lg transform transition-all duration-300 translate-x-0 z-50 flex items-center bg-danger text-white';
                    icon.className = 'fa fa-exclamation-circle mr-2';
                    break;
                case 'warning':
                    toast.className = 'fixed top-4 right-4 px-4 py-2 rounded-lg shadow-lg transform transition-all duration-300 translate-x-0 z-50 flex items-center bg-warning text-white';
                    icon.className = 'fa fa-exclamation-triangle mr-2';
                    break;
                default:
                    toast.className = 'fixed top-4 right-4 px-4 py-2 rounded-lg shadow-lg transform transition-all duration-300 translate-x-0 z-50 flex items-center bg-primary text-white';
                    icon.className = 'fa fa-info-circle mr-2';
                    break;
            }

            messageEl.textContent = message;

            // 清理上一个定时器，避免互相干扰
            if (toastTimer) clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                toast.classList.add('translate-x-full');
                toastTimer = null;
            }, 3000);
        }
    </script>
</body>

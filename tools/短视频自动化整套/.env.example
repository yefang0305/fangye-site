# ============================================================
# 短视频自动化工具集 — 环境变量配置模板
# 复制为 .env 并填入实际值
# ============================================================

# --- LLM API (OpenAI 兼容接口) ---
# 用于 ASR 文案清洗和适配审查
# 默认使用火山引擎豆包模型，可替换为任意 OpenAI 兼容 API
LLM_API_KEY=your-api-key-here
LLM_MODEL=doubao-seed-2.0-pro
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3

# --- 抖音下载 ---
# CR TubeGet 安装目录（用于抖音视频直链解析和 Cookie 导出）
# 需要包含 qjs.exe 和 crck.exe
CRTUBEGET_DIR=J:\MagicTool\crtubeget

# 抖音 Cookie 文件路径（Netscape 格式 cookies.txt）
DOUYIN_COOKIE_FILE=

# 从浏览器读取 Cookie（如 chrome, edge, firefox）
DOUYIN_COOKIES_FROM_BROWSER=

# --- ASR 配置 ---
# 本地 Whisper 模型名称: tiny, base, small, medium, large-v2, large-v3
ASR_MODEL=large-v3

# 设备: cuda 或 cpu
ASR_DEVICE=cuda

# 计算类型: int8_float16, int8, float16, float32
ASR_COMPUTE_TYPE=int8_float16

# 语言: zh (中文), auto (自动检测)
ASR_LANGUAGE=zh

# 模型缓存目录
ASR_MODEL_DIR=./models

# 外部 ASR 脚本根目录（如果使用独立 ASR 环境）
# EXTERNAL_ASR_ROOT=J:\MagicTool\asr_project

# --- 数据存储 ---
# 脚本库索引文件路径
SCRIPT_LIBRARY_PATH=./data/library.json

# 摄入状态文件路径
STATE_STORE_PATH=./data/ingestion_state.json

# 视频下载目录
VIDEO_LIBRARY_DIR=./data/videos

# --- MediaPush 分发 ---
# MediaPush 项目根目录（用于批量视频发布）
MEDIAPUSH_INBOX_DIR=J:\MagicTool\emdia\MediaPush\inbox

# --- 发布时段 ---
# 可选: morning, noon, evening
PUBLISH_SLOT=morning

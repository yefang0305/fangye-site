# MediaPush 环境配置示例
# 复制本文件为 .env 并填入实际路径

# Playwright 浏览器安装路径（由用户全局环境变量提供）
# PLAYWRIGHT_BROWSERS_PATH=J:\playwright-browsers

# SQLite 数据库路径
MEDIAPUSH_DB_PATH=./data/mediapush.db

# 浏览器 Profile 存储目录（每个账号一个子目录）
MEDIAPUSH_PROFILES_PATH=./profiles

# 收件箱目录（VideoCut 输出视频到此目录，watcher 自动抓取并发布）
MEDIAPUSH_INBOX_PATH=./inbox

# 已处理的收件箱批次归档目录
MEDIAPUSH_INBOX_PROCESSED_PATH=./inbox/processed

# 收件箱轮询间隔（秒）
MEDIAPUSH_INBOX_POLL_SECONDS=5

# 启动时自动清理历史记录：0=禁用，1=启用（默认）
MEDIAPUSH_AUTO_PURGE_HISTORY=1
